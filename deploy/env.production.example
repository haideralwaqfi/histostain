# HistoStains — Production .env template
# Copy to /var/www/histostains/.env and fill in every blank value.
# NEVER commit this file with real secrets.
#
# After editing:
#   php artisan config:cache   (re-run any time you change this file)

# ── App ───────────────────────────────────────────────────────────────────
APP_NAME=HistoStains
APP_ENV=production
APP_KEY=                          # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://histostains.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────
LOG_CHANNEL=daily                 # rotates logs daily; keeps 14 days
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                 # error | warning | info | debug

# ── Database (MySQL 8) ────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=histostains
DB_USERNAME=histostains
DB_PASSWORD=                      # set during provision.sh

# ── Sessions + Cache ──────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=480              # 8 hours
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=histostains.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=spaces            # use DO Spaces for all public media

# ── Queue ─────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database         # Supervisor keeps workers running

# ── Mail ─────────────────────────────────────────────────────────────────
# Mailgun example — swap for any SMTP provider
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=                    # Mailgun SMTP login
MAIL_PASSWORD=                    # Mailgun SMTP password
MAIL_FROM_ADDRESS=noreply@histostains.example.com
MAIL_FROM_NAME="HistoStains"

# ── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://histostains.example.com/auth/google/callback

# ── DigitalOcean Spaces ───────────────────────────────────────────────────
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3             # e.g. nyc3, ams3, sgp1
DO_SPACES_BUCKET=histostains-prod
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_CDN_URL=https://histostains-prod.nyc3.cdn.digitaloceanspaces.com

# ── Web Push (VAPID) ──────────────────────────────────────────────────────
# Generated by: php artisan webpush:vapid
VAPID_SUBJECT=mailto:admin@histostains.example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

# ── Vite ──────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
